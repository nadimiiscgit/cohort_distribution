# cohort_distribution — environment template
#
# Copy to .env and fill in real values. .env is gitignored and must NEVER be
# committed. Every variable the code reads is listed here; anything not listed
# here is not read by this repo.
#
#   cp .env.example .env
#   $EDITOR .env
#   python scripts/verify.py        # confirms the file is complete and sane


# =============================================================================
# Telegram
# =============================================================================

# Bot token from @BotFather. Required. Format: "<digits>:<35-char secret>".
# Treat as a password: rotate via @BotFather if it ever leaks.
TELEGRAM_BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# The bot's @username WITHOUT the leading "@". Required.
# Used to build attribution deep links (https://t.me/<username>?start=<code>)
# and to substitute into the landing page at deploy time.
TELEGRAM_BOT_USERNAME=your_bot_username

# Comma-separated Telegram chat IDs allowed to run admin-only commands
# (/stats) and to receive operational alerts. Optional but strongly
# recommended. Get yours by messaging the bot and reading the logs.
ADMIN_CHAT_IDS=

# Seconds to wait between individual sends during a broadcast. Telegram's
# practical ceiling is ~30 messages/sec overall; 0.05 (=20/sec) leaves headroom.
BROADCAST_RATE_LIMIT=0.05


# =============================================================================
# Storage
# =============================================================================

# Path to the SQLite database file. Relative paths resolve from the repo root.
# The file itself is gitignored — it holds subscriber chat IDs.
DATABASE_PATH=data/cohort.db

# Default CSV consumed by scripts/seed_questions.py when no path is passed.
# Real question CSVs are gitignored; only data/sample.csv is committed.
QUESTIONS_CSV=data/questions.csv

# Where scripts/backup.py writes timestamped database snapshots.
BACKUP_DIR=backups

# Backups older than this many days are pruned by scripts/backup.py.
BACKUP_RETENTION_DAYS=14


# =============================================================================
# Delivery behaviour
# =============================================================================

# Hour of day (0-23, TIMEZONE below) that the daily-question cron fires.
# Informational for the app; the actual schedule lives in deploy/crontab.example
# and must be kept in sync by hand.
DAILY_QUESTION_HOUR=9

# IANA timezone name used for all human-facing scheduling and reports.
TIMEZONE=Asia/Kolkata

# Number of questions a subscriber may pull per day via /question.
DAILY_QUESTION_LIMIT=5


# =============================================================================
# Attribution
# =============================================================================

# Public base URL of the landing page. Used by scripts/attribution.py link
# to print ready-to-paste campaign URLs. No trailing slash.
LANDING_BASE_URL=https://example.com

# Source code recorded when someone opens the bot with no ?start= payload.
DEFAULT_SOURCE=direct

# Web server access log(s) that scripts/import_clicks.py reads to count
# landing-page clicks per campaign code. A glob is allowed, so a rotation
# pattern like /var/log/nginx/access.log* picks up rotated and gzipped files
# too. The service user needs read access — on Debian/Ubuntu that usually
# means adding it to the adm group.
ACCESS_LOG_PATH=/var/log/nginx/access.log


# =============================================================================
# Operations
# =============================================================================

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# When "1"/"true", broadcast and other outbound scripts print what they would
# send instead of sending it. Scripts also default to dry-run unless --send is
# passed; this is the belt to that pair of braces.
DRY_RUN=false
