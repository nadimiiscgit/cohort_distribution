# cohort_distribution — environment template
#
# Copy to .env and fill in real values. .env is gitignored and must NEVER be
# committed. Every variable the code reads is listed here; anything not listed
# here is not read by this repo.
#
#   cp .env.example .env
#   $EDITOR .env
#   python scripts/verify.py        # confirms the file is complete and sane


# =============================================================================
# The bot
# =============================================================================

# Bot token from @BotFather. Required. Format: "<digits>:<35-char secret>".
# Treat as a password: rotate via @BotFather if it ever leaks.
BOT_TOKEN=8951613177:AAFPxQ67svD9D2yg6mVtcdCDGi7IPfGfgB0

# Telegram user id allowed to run /stats. A single id, not a list — /stats is
# the only privileged command and one operator is the whole audience for it.
# Unset means /stats answers nobody. Get yours by messaging the bot and
# reading the log line it prints.
ADMIN_ID=5886550719

# Where the CTA button under an answered question points. The bot appends
# ?src=<source_channel>&uid=<user_id>&qid=<question_id> to whatever you put
# here, so click-through can be attributed at the destination — Telegram does
# not report taps on a URL button (see NOTES.md). Existing query parameters
# are preserved, so utm tags are fine.
# Unset means answers get no button and the experiment measures nothing.
CTA_URL=https://www.meridianneetpg.in/

# Path to the SQLite database file. Relative paths resolve from the repo root.
# The file itself is gitignored — it holds subscriber user IDs.
DB_PATH=data/cohort.db

# Hour of day the daily question goes out. This is documentation, not a
# scheduler: cron is the authority. Keep it in sync with the daily.py line in
# deploy/crontab.example by hand.
BROADCAST_HOUR=9


# =============================================================================
# Telegram, supporting
# =============================================================================

# The bot's @username WITHOUT the leading "@". Required.
# Used to build attribution deep links (https://t.me/<username>?start=<code>)
# and substituted into the landing page at deploy time.
TELEGRAM_BOT_USERNAME=meridianpg_bot

# Seconds to wait between individual sends during a broadcast. Telegram's
# practical ceiling is ~30 messages/sec overall; 0.05 (=20/sec) leaves headroom.
BROADCAST_RATE_LIMIT=0.05


# =============================================================================
# Storage
# =============================================================================

# Default CSV consumed by scripts/seed.py when no path is passed.
# Real question CSVs are gitignored; only data/sample.csv is committed.
QUESTIONS_CSV=data/questions.csv

# Where scripts/backup.py writes timestamped database snapshots.
BACKUP_DIR=backups

# Backups older than this many days are pruned by scripts/backup.py.
BACKUP_RETENTION_DAYS=14


# =============================================================================
# Attribution
# =============================================================================

# Public base URL of the landing page. Used by scripts/attribution.py link
# to print ready-to-paste campaign URLs. No trailing slash.
LANDING_BASE_URL=https://example.com

# Web server access log(s) that scripts/import_clicks.py reads to count
# landing-page clicks per channel. A glob is allowed, so a rotation pattern
# like /var/log/nginx/access.log* picks up rotated and gzipped files too.
# The service user needs read access — on Debian/Ubuntu that usually means
# adding it to the adm group.
ACCESS_LOG_PATH=/var/log/nginx/access.log


# =============================================================================
# Operations
# =============================================================================

# IANA timezone name, for humans reading logs. Everything the code stores and
# every date it compares is UTC.
TIMEZONE=Asia/Kolkata

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# When "1"/"true", outbound scripts print what they would send instead of
# sending it. broadcast.py also defaults to dry-run unless --send is passed;
# this is the belt to that pair of braces, and it vetoes daily.py too.
DRY_RUN=false
